{
  "name": "@barat/test-utils",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministic factories, fixtures and seed helpers. Source is owned by workstream S6/B10.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./factories": "./src/factories/index.ts",
    "./fixtures": "./src/fixtures/index.ts",
    "./database": "./src/database.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@barat/contracts": "workspace:*",
    "@faker-js/faker": "10.6.0",
    "decimal.js": "10.6.0"
  },
  "peerDependencies": {
    "@barat/database": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@barat/database": {
      "optional": true
    }
  },
  "devDependencies": {
    "@barat/config": "workspace:*",
    "@barat/database": "workspace:*",
    "@types/node": "26.4.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
