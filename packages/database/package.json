{
  "name": "@barat/database",
  "version": "0.1.0",
  "private": true,
  "description": "Prisma schema, migrations, seed and the shared PrismaClient singleton. Schema is FROZEN.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "generated", "prisma"],
  "scripts": {
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force",
    "build": "prisma generate && tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "clean": "rm -rf dist generated *.tsbuildinfo",
    "lint": "eslint src prisma",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client-runtime-utils": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "0.45.1",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@barat/config": "workspace:*",
    "@types/node": "26.4.0",
    "@types/pg": "8.23.1",
    "dotenv": "17.4.2",
    "prisma": "7.10.0",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  }
}
