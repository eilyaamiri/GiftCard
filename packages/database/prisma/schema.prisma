// ===========================================================================
// Barat Pay — data model
//
// FROZEN after Phase 0. Only the Foundation agent may change this file.
//
// Iron rules (AGENTS.md section 6):
//   1. Every rial amount is BigInt. There is no Float money column anywhere.
//   2. Every foreign-currency amount is Decimal @db.Decimal(18, 6).
//   3. Every percentage / rate / fee rate is Int basis points (100 bps = 1%).
//   4. Quote is an immutable SNAPSHOT of values, never a set of references.
//   5. GiftCardAsset stores ciphertext only (AES-256-GCM at the application
//      layer). There is no plaintext code column and no code is ever logged.
//   6. Financial history is never hard-deleted; only status changes.
//
// Prisma 7 note: the datasource has no `url`. The connection string lives in
// prisma.config.ts and PrismaClient is constructed with @prisma/adapter-pg.
// ===========================================================================

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

// ===========================================================================
// ENUMS — mirror packages/contracts exactly. Adding a value here without
// adding it there (or the reverse) is a bug.
// ===========================================================================

