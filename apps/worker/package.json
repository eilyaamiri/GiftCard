{
  "name": "@barat/worker",
  "version": "0.1.0",
  "private": true,
  "description": "Barat Pay background worker — NestJS standalone application driving BullMQ queues",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "clean": "rm -rf dist *.tsbuildinfo",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@barat/contracts": "workspace:*",
    "@barat/database": "workspace:*",
    "@barat/fx": "workspace:*",
    "@barat/notifications": "workspace:*",
    "@barat/payments": "workspace:*",
    "@barat/suppliers": "workspace:*",
    "@nestjs/common": "12.0.1",
    "@nestjs/config": "12.0.0",
    "@nestjs/core": "12.0.1",
    "bullmq": "6.3.2",
    "decimal.js": "10.6.0",
    "ioredis": "6.0.0",
    "nestjs-pino": "4.6.1",
    "pino": "10.3.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@barat/config": "workspace:*",
    "@barat/test-utils": "workspace:*",
    "@types/node": "26.4.0",
    "pino-pretty": "13.1.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
