{
  "name": "@barat/api",
  "version": "0.1.0",
  "private": true,
  "description": "Barat Pay API — NestJS modular monolith",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "clean": "rm -rf dist *.tsbuildinfo",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@barat/contracts": "workspace:*",
    "@barat/database": "workspace:*",
    "@barat/fx": "workspace:*",
    "@barat/notifications": "workspace:*",
    "@barat/payments": "workspace:*",
    "@barat/suppliers": "workspace:*",
    "@nestjs/common": "12.0.1",
    "@nestjs/config": "12.0.0",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-express": "12.0.1",
    "@nestjs/swagger": "12.0.1",
    "@nestjs/throttler": "6.5.0",
    "argon2": "0.45.1",
    "bullmq": "6.3.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "decimal.js": "10.6.0",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "jose": "6.2.10",
    "nanoid": "6.0.1",
    "nestjs-pino": "4.6.1",
    "pino": "10.3.1",
    "pino-http": "10.5.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@barat/config": "workspace:*",
    "@barat/test-utils": "workspace:*",
    "@nestjs/cli": "12.0.0",
    "@nestjs/testing": "12.0.1",
    "@nestjs/schematics": "12.0.0",
    "@types/node": "26.4.0",
    "pino-pretty": "13.1.3",
    "supertest": "7.2.2",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
