# ============================================================================
# Barat Pay — example environment
# Copy to `.env` and fill in real values. NEVER commit a real `.env`.
# Every variable below is validated at boot by apps/api/src/common/config.
# A missing or malformed value is a fail-fast boot error, never a silent default.
# ============================================================================

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000

# ---------------------------------------------------------------------------
# Infrastructure
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://barat:barat@localhost:5432/barat?schema=public"
REDIS_URL="redis://localhost:6379"

# ---------------------------------------------------------------------------
# Public URLs (used for CORS, payment callbacks, e-mail links)
# ---------------------------------------------------------------------------
API_PUBLIC_URL="http://localhost:4000"
WEB_PUBLIC_URL="http://localhost:3000"
ADMIN_PUBLIC_URL="http://localhost:3001"

# ---------------------------------------------------------------------------
# Secrets
# SESSION_JWT_SECRET      : >= 32 chars, random. Rotate per environment.
# GIFT_CARD_ENCRYPTION_KEY: 32 raw bytes, base64 encoded (AES-256-GCM key).
#                           Generate with: openssl rand -base64 32
# BANK_DETAILS_ENCRYPTION_KEY: same format, for customers' own IBAN and card.
#                           Optional; falls back to GIFT_CARD_ENCRYPTION_KEY.
#                           Set a DISTINCT key in production so that compromising
#                           one domain's key does not open the other's columns.
# ---------------------------------------------------------------------------
SESSION_JWT_SECRET="change-me-to-a-random-32-byte-minimum-secret"
GIFT_CARD_ENCRYPTION_KEY="AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="
BANK_DETAILS_ENCRYPTION_KEY=""

# ---------------------------------------------------------------------------
# OTP policy
# ---------------------------------------------------------------------------
OTP_LENGTH=6
OTP_TTL_SECONDS=120
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_REQUESTS_PER_HOUR=10

# ---------------------------------------------------------------------------
# ZarinPal (rial payment gateway)
# ZARINPAL_AMOUNT_UNIT is an OPEN DECISION — it must be confirmed against the
# real merchant contract before production. Code supports IRR and IRT and
# rejects non-divisible conversions.
# ---------------------------------------------------------------------------
ZARINPAL_ENABLED=false
ZARINPAL_MERCHANT_ID="00000000-0000-0000-0000-000000000000"
ZARINPAL_REQUEST_URL="https://payment.zarinpal.com/pg/v4/payment/request.json"
ZARINPAL_VERIFY_URL="https://payment.zarinpal.com/pg/v4/payment/verify.json"
ZARINPAL_STARTPAY_URL="https://payment.zarinpal.com/pg/StartPay"
ZARINPAL_CALLBACK_URL="http://localhost:4000/api/payments/zarinpal/callback"
ZARINPAL_REQUEST_TIMEOUT_MS=10000
ZARINPAL_AMOUNT_UNIT=IRR

# ---------------------------------------------------------------------------
# Pricing / FX policy
# FX_STALE_THRESHOLD_SECONDS: older than this => quote creation is REJECTED.
# QUOTE_TTL_SECONDS         : default TTL, overridable per PricingRule.
# ---------------------------------------------------------------------------
FX_STALE_THRESHOLD_SECONDS=900
QUOTE_TTL_SECONDS=600

# ---------------------------------------------------------------------------
# Background worker (apps/worker)
# ---------------------------------------------------------------------------
WORKER_CONCURRENCY=5
